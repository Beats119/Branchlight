{
  "name": "branchlight",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Branchlight — follow every question. An in-place branching reading companion (first milestone, mock responses).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "npm run build && playwright test",
    "desktop:install": "install-electron",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "desktop": "npm run build && npm run build:desktop && electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sparticuz/chromium": "158.0.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "25.0.1",
    "prettier": "3.10.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop-dist/main.js"
}
